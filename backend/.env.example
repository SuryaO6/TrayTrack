# Gmail account used to SEND alert emails (not a student's account).
# SMTP_APP_PASSWORD is a 16-char Google "App Password", not your real Gmail password.
# If left blank, emails are skipped (logged only) — nothing else breaks.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
