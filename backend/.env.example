# Optional Aiven CA certificate in PEM format for verified TLS connections.
DB_SSL_CA=

GOOGLE_CLIENT_ID=792887341773-el82aas0ddnbdf0us57ctq9v1i9ka1bt.apps.googleusercontent.com

